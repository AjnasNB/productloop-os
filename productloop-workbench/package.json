{
  "name": "productloop-workbench",
  "version": "0.1.0",
  "description": "Local control center for durable governed runs, exact approvals, evidence, memory links, and policy inspection across the ProductLoop stack.",
  "type": "module",
  "license": "MIT",
  "author": "Ajnas NB",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AjnasNB/productloop-os.git",
    "directory": "productloop-workbench"
  },
  "homepage": "https://maqamagent.com/docs/workbench/",
  "bugs": {
    "url": "https://github.com/AjnasNB/productloop-os/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agents",
    "governance",
    "human-in-the-loop",
    "approvals",
    "evidence",
    "local-first",
    "maqam",
    "productloop"
  ],
  "bin": {
    "productloop-workbench": "bin/productloop-workbench.js",
    "productloop-workbench-cli": "bin/productloop-workbench.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "node bin/productloop-workbench.js demo --json",
    "doctor": "node bin/productloop-workbench.js doctor --json",
    "pack:dry": "npm pack --dry-run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run test && npm run typecheck"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "dependencies": {
    "productloop-os": "^0.2.3"
  },
  "peerDependencies": {
    "cockroach-browser": ">=0.2.1",
    "cockroach-crawler": ">=0.3.0-alpha.1",
    "qarinah": ">=0.1.2"
  },
  "peerDependenciesMeta": {
    "cockroach-browser": {
      "optional": true
    },
    "cockroach-crawler": {
      "optional": true
    },
    "qarinah": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
